{
  "page": {
    "label": "TRANSLATE.OUTCAST.PAGE_TITLE"
  },
  "sections": [
    {
      "id": "icecast_section",
      "element": "section",
      "label": "TRANSLATE.OUTCAST.ICE_SECTION",
      "icon": "fa-rss",
      "description": "TRANSLATE.OUTCAST.ICE_SECTION_DESC",
      "onSave": { "type": "controller", "endpoint": "audio_interface/outcast", "method": "updateIcecast" },
      "saveButton": {
        "label": "TRANSLATE.OUTCAST.SAVE",
        "data": ["ice_enabled", "ice_host", "ice_port", "ice_protocol", "ice_mount", "ice_stream_id", "ice_user", "ice_password", "ice_preset", "ice_advanced", "ice_codec", "ice_bitrate", "ice_rate", "ice_channels", "ice_name", "ice_keep_alive", "ice_more", "ice_description", "ice_genre", "ice_url", "ice_public"]
      },
      "content": [
        { "id": "ice_enabled", "element": "switch", "label": "TRANSLATE.OUTCAST.ICE_ENABLE", "doc": "TRANSLATE.OUTCAST.ICE_ENABLE_DESC", "value": false },
        { "id": "ice_host", "element": "input", "label": "TRANSLATE.OUTCAST.ICE_HOST", "doc": "TRANSLATE.OUTCAST.ICE_HOST_DESC", "value": "", "visibleIf": { "field": "ice_enabled", "value": true } },
        { "id": "ice_port", "element": "input", "label": "TRANSLATE.OUTCAST.ICE_PORT", "doc": "TRANSLATE.OUTCAST.ICE_PORT_DESC", "value": "8000", "visibleIf": { "field": "ice_enabled", "value": true } },
        { "id": "ice_protocol", "element": "select", "label": "TRANSLATE.OUTCAST.ICE_PROTOCOL", "doc": "TRANSLATE.OUTCAST.ICE_PROTOCOL_DESC", "value": { "value": "icecast2", "label": "Icecast 2" },
          "options": [ { "value": "icecast2", "label": "Icecast 2" }, { "value": "shoutcast1", "label": "SHOUTcast" } ],
          "visibleIf": { "field": "ice_enabled", "value": true } },
        { "id": "ice_mount", "element": "input", "label": "TRANSLATE.OUTCAST.ICE_MOUNT", "doc": "TRANSLATE.OUTCAST.ICE_MOUNT_DESC", "value": "/volumio.mp3", "visibleIf": { "field": "ice_protocol", "value": "icecast2" } },
