          "options": [ { "value": "mp3", "label": "MP3" }, { "value": "aac", "label": "AAC" }, { "value": "opus", "label": "Opus" }, { "value": "vorbis", "label": "Ogg Vorbis" }, { "value": "flac", "label": "FLAC" } ],
          "visibleIf": { "field": "ice_advanced", "value": true } },
        { "id": "ice_bitrate", "element": "input", "label": "TRANSLATE.OUTCAST.BITRATE", "doc": "TRANSLATE.OUTCAST.BITRATE_DESC", "value": "128", "visibleIf": { "field": "ice_advanced", "value": true } },
