          "visibleIf": { "field": "ice_enabled", "value": true } },
        { "id": "ice_advanced", "element": "switch", "label": "TRANSLATE.OUTCAST.ADVANCED", "doc": "TRANSLATE.OUTCAST.ADVANCED_DESC", "value": false, "visibleIf": { "field": "ice_enabled", "value": true } },
