        { "id": "ice_channels", "element": "select", "label": "TRANSLATE.OUTCAST.CHANNELS", "doc": "TRANSLATE.OUTCAST.CHANNELS_DESC", "value": { "value": "2", "label": "TRANSLATE.OUTCAST.CHANNELS_STEREO" },
          "options": [ { "value": "2", "label": "TRANSLATE.OUTCAST.CHANNELS_STEREO" }, { "value": "1", "label": "TRANSLATE.OUTCAST.CHANNELS_MONO" }, { "value": "0", "label": "TRANSLATE.OUTCAST.RATE_SOURCE" } ],
          "visibleIf": { "field": "ice_advanced", "value": true } },
        { "id": "ice_name", "element": "input", "label": "TRANSLATE.OUTCAST.STREAM_NAME", "doc": "TRANSLATE.OUTCAST.STREAM_NAME_DESC", "value": "Volumio", "visibleIf": { "field": "ice_enabled", "value": true } },
        { "id": "ice_keep_alive", "element": "switch", "label": "TRANSLATE.OUTCAST.KEEP_ALIVE", "doc": "TRANSLATE.OUTCAST.ICE_KEEP_ALIVE_DESC", "value": true, "visibleIf": { "field": "ice_enabled", "value": true } },
        { "id": "ice_more", "element": "switch", "label": "TRANSLATE.OUTCAST.ICE_MORE", "doc": "TRANSLATE.OUTCAST.ICE_MORE_DESC", "value": false, "visibleIf": { "field": "ice_enabled", "value": true } },
        { "id": "ice_description", "element": "input", "label": "TRANSLATE.OUTCAST.ICE_DESCRIPTION", "doc": "TRANSLATE.OUTCAST.ICE_DESCRIPTION_DESC", "value": "", "visibleIf": { "field": "ice_more", "value": true } },
        { "id": "ice_genre", "element": "input", "label": "TRANSLATE.OUTCAST.ICE_GENRE", "doc": "TRANSLATE.OUTCAST.ICE_GENRE_DESC", "value": "", "visibleIf": { "field": "ice_more", "value": true } },
        { "id": "ice_url", "element": "input", "label": "TRANSLATE.OUTCAST.ICE_URL", "doc": "TRANSLATE.OUTCAST.ICE_URL_DESC", "value": "", "visibleIf": { "field": "ice_more", "value": true } },
        { "id": "ice_public", "element": "switch", "label": "TRANSLATE.OUTCAST.ICE_PUBLIC", "doc": "TRANSLATE.OUTCAST.ICE_PUBLIC_DESC", "value": false, "visibleIf": { "field": "ice_more", "value": true } }
      ]
    },
